# 复制为 premarket_jobs.env 后按需修改（install 脚本会自动 source）
# cp scripts/premarket_jobs.env.example scripts/premarket_jobs.env

# openclaw 微信推送（Gateway 需已启动）
OPENCLAW_BIN="$HOME/.npm-global/bin/openclaw"
# OPENCLAW_WEIXIN_TARGET=o9cq809WYr9JuLYry23aicMuyckY@im.wechat

# 轮动短线默认：forecast + LLM + TA，不跑深度 analyze
PREMARKET_RUN_FORECAST=1
PREMARKET_RUN_AUDIT=1
PREMARKET_AUDIT_DAYS=3,5
PREMARKET_OPEN_FORECAST=1
PREMARKET_RUN_TA=1
PREMARKET_RUN_DEEP=0
PREMARKET_LLM=1
PREMARKET_LLM_OPEN=0
PREMARKET_DEEP_CURATE=1

# 非交易日自动跳过（A 股日历）
PREMARKET_SKIP_NON_TRADING_DAY=1

# P1 复盘硬门禁（run_recommend 策略暂停 / 板块高 PE 剔除）
# TRADINGAGENTS_FORCE_CURATION=1   # 生产推荐强制 Stage3 硬规则+LLM

# 闭环健康检查（verify_recommendation_loop.sh exit: 0=ok 1=warn 2=critical）
# VERIFY_MIN_AUDIT_SAMPLES=5
# VERIFY_MIN_WIN_RATE=0.5
# VERIFY_WIN_RATE_MIN_SAMPLES=10
# VERIFY_REQUIRE_LAUNCHD=1
# AUDIT_GATE_LOOKBACK_DAYS=30
# AUDIT_GATE_MIN_SAMPLES=3
# AUDIT_GATE_MIN_WIN_RATE=0.4
# AUDIT_GATE_HORIZON=3
# AUDIT_GATE_HIGH_PE=60
# AUDIT_GATE_SECTOR_MIN_LOSSES=2
