# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=

# Optional: point at a remote Ollama server. When unset, defaults to
# the local instance at http://localhost:11434/v1. Convention follows
# the broader Ollama ecosystem; both the CLI dropdown and programmatic
# client pick this up.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# Optional: override DEFAULT_CONFIG without editing code.
# Any TRADINGAGENTS_* variable below, when set, replaces the matching key
# in tradingagents/default_config.py. Values are coerced to the type of
# the existing default (bool / int / str), so "true"/"3" work as expected.
#TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.4
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.4-mini
# DeepSeek: unify deep/quick on V4.1 Flash (official model id: deepseek-flash)
#TRADINGAGENTS_LLM_PROVIDER=deepseek
#TRADINGAGENTS_DEEP_THINK_LLM=deepseek-flash
#TRADINGAGENTS_QUICK_THINK_LLM=deepseek-flash
#TRADINGAGENTS_LLM_BACKEND_URL=
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
# Decision framing: retail (individual investor, default) | empty (flat, no position) | held (already own the ticker)
# TRADINGAGENTS_POSITION_CONTEXT=retail   # retail(默认) | empty(空仓/观望) | held(有持仓)
# Optional: inject cost basis + shares into verified_market_facts (auto-sets held)
#TRADINGAGENTS_POSITION_COST=13.84
#TRADINGAGENTS_POSITION_SHARES=1000
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TRADINGAGENTS_CHECKPOINT_ENABLED=false
# CN: all market data via a-share-data skill (~/.cursor/skills/a-share-data/run.sh)
#TRADINGAGENTS_MARKET=cn
#TRADINGAGENTS_OUTPUT_LANGUAGE=Chinese
# macro_plus_ticker (default) | macro_only | ticker_only
#TRADINGAGENTS_GLOBAL_NEWS_MODE=macro_plus_ticker
# Progress lines on stderr during propagate (0=off)
#TRADINGAGENTS_PROGRESS_LOG=1
# Analyst fan-out when >1 (default 4 = parallel); set 1 for legacy sequential
#TRADINGAGENTS_ANALYST_CONCURRENCY=4
# Storage (default ~/.tradingagents/…; falls back to ./.tradingagents/… if home is not writable)
#TRADINGAGENTS_RESULTS_DIR=./results
#TRADINGAGENTS_CACHE_DIR=./.tradingagents/cache
#TRADINGAGENTS_MEMORY_LOG_PATH=./.tradingagents/memory/trading_memory.md
# Optional: path to a-share-data run.sh (default ~/.cursor/skills/a-share-data/run.sh)
#A_SHARE_DATA_RUN_SH=

# Optional: Xueqiu cookie for fetch_xueqiu_status (browser xq_a_token)
#XUEQIU_COOKIE=

# Required for US equities (default data_vendors=alpha_vantage; no Yahoo/yfinance)
# Get a free API Key: https://www.alphavantage.co/support/#api-key
#ALPHA_VANTAGE_API_KEY=

